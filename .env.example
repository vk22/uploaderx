# Read by `docker compose` for variable substitution in docker-compose.yml.
# Copy to .env and adjust for this host; .env is gitignored.

# Where uploaded audio/covers and generated videos are stored on the host.
# Local dev default (./data/uploads) is fine to leave unset.
# On a VPS, point this at a fixed path outside the repo so it survives
# redeploys/reclones, e.g.:
# UPLOADS_DIR=/var/lib/uploaderx/uploads
